<!DOCTYPE html>
<html data-theme="silk">
  <head>
    <title><%= content_for(:title) || "Imprecise Analysis" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Imprecise Analysis">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app %>
    <%= javascript_include_tag "application", type: "module" %>
  </head>

  <body>
    <nav class="navbar">
      <ul class="menu menu-horizontal w-full flex items-center gap-1">
        <li><%= link_to "Imprecise Analysis", root_path, class: "btn btn-sm btn-ghost" %></li>
        <% if authenticated? %>
          <li><%= link_to "Projects",  projects_path, class: "btn btn-sm btn-ghost" %></li>
          <li><%= link_to "Daily Usage", daily_usages_path, class: "btn btn-sm btn-ghost" %></li>
          <li class="ml-auto">
            <%= form_tag session_path, method: :delete, class: "p-0" do %>
              <%= submit_tag "Log out", class: "btn btn-sm btn-soft" %>
            <% end %>
          </li>
        <% else %>
          <li class="ml-auto"><%= link_to "Log in", new_session_path, class: "btn btn-sm btn-soft" %></li>
        <% end %>
      </ul>
    </nav>

    <main class="p-4">
      <% if notice %>
        <div class="alert alert-success mb-4">
          <span><%= notice %></span>
        </div>
      <% end %>
      
      <% if alert %>
        <div class="alert alert-error mb-4">
          <span><%= alert %></span>
        </div>
      <% end %>
      
      <%= yield %>
    </main>
  </body>
</html>
