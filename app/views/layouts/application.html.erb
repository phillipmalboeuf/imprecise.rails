<!DOCTYPE html>
<html data-theme="silk">
  <head>
    <title><%= content_for(:title) || "Imprecise Analysis" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Imprecise Analysis">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes Tailwind CSS compiled by tailwindcss-rails %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    
    <% if Rails.env.development? %>
      <%# Vite dev server with HMR %>
      <script type="module" src="http://localhost:3036/app/javascript/application.tsx"></script>
    <% else %>
      <%# Production: built assets %>
      <%= javascript_include_tag "application", type: "module" %>
    <% end %>
  </head>

  <body>
    <nav class="navbar sticky top-0 z-50 bg-base-100">
      <ul class="menu menu-horizontal w-full flex items-center gap-1">
        <li><%= link_to(raw("<em>I</em>A"), root_path, class: "text-2xl font-bold gap-0") %></li>
        <% if authenticated? %>
          <li><%= link_to "Projects",  projects_path, class: "btn btn-sm btn-ghost" %></li>
          <li><%= link_to "Daily Usage", daily_usages_path, class: "btn btn-sm btn-ghost" %></li>
          <li class="ml-auto">
            <%= form_tag session_path, method: :delete, class: "p-0" do %>
              <%= submit_tag "Log out", class: "btn btn-sm btn-soft" %>
            <% end %>
          </li>
        <% else %>
          <li class="ml-auto"><%= link_to "Log in", new_session_path, class: "btn btn-sm btn-soft" %></li>
        <% end %>
      </ul>
    </nav>

    <main class="p-6 min-h-screen">
      <% if notice %>
        <div class="alert alert-success mb-4">
          <span><%= notice %></span>
        </div>
      <% end %>
      
      <% if alert %>
        <div class="alert alert-error mb-4">
          <span><%= alert %></span>
        </div>
      <% end %>
      
      <%= yield %>
    </main>

    <footer class="footer px-8 py-6 bg-neutral text-neutral-content">
      <aside class="flex justify-between items-center w-full">
        <p class="text-sm">© <%= Date.current.year %> Phil's Computer</p>
        <p>
          <a href="https://github.com/phillipmalboeuf/imprecise.rails" target="_blank" rel="noopener noreferrer" class="btn btn-ghost">
            GitHub
          </a>
        </p>
      </aside>
    </footer>
  </body>
</html>
