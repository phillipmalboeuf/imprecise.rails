<h1 class="text-2xl font-bold mb-4">Edit Project</h1>

<%= tag.div(flash[:alert], style: "color:red") if flash[:alert] %>
<%= tag.div(flash[:notice], style: "color:green") if flash[:notice] %>

<%= form_with class: "form space-y-2", model: @project, url: project_path(@project) do |form| %>
  <% if @project.errors.any? %>
    <div style="color:red">
      <h2><%= pluralize(@project.errors.count, "error") %> prohibited this project from being saved:</h2>
      <ul>
        <% @project.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= form.label :name, "Name", class: "label" %><br>
  <%= form.text_field :name, required: true, autofocus: true, placeholder: "Enter project name", class: "input" %><br>

  <%= form.label :slug, "Slug", class: "label" %><br>
  <%= form.text_field :slug, required: true, placeholder: "Enter project slug (e.g., my-project)", class: "input" %><br>

  <%= form.label :status, "Status", class: "label" %><br>
  <%= form.select :status, options_for_select([["Draft", "draft"], ["Published", "published"], ["Archived", "archived"]], @project.status), { prompt: "Select status" }, { required: true, class: "input" } %><br>

  <%= form.label :prompt_type, "Prompt Type", class: "label" %><br>
  <%= form.select :prompt_type, options_for_select([["Is it Spam", "is-it-spam"], ["Is it AI", "is-it-ai"], ["Topics", "topics"], ["Sentiment", "sentiment"]], @project.prompt_type), { prompt: "Select prompt type" }, { required: true, class: "input" } %><br>

  <%= form.submit "Update Project", class: "btn btn-primary" %>
<% end %>

<br>

<%= link_to "Back to project", @project, class: "btn btn-soft" %>
<%= link_to "Back to projects", projects_path, class: "btn btn-soft" %>
