<h1 class="text-2xl font-bold mb-4"><%= @project.name %></h1>

<div class="mb-4">
  <%= link_to "Edit Project", edit_project_path(@project), class: "btn btn-soft mb-2" %>
  <p><strong>Prompt Type:</strong> <%= @project.prompt_type %></p>
  <p><strong>Status:</strong> <%= @project.status %></p>
</div>

<div class="mb-6">
  <h2 class="text-xl font-semibold mb-3">Create Query</h2>
  <% if @project.published? %>
    <%= form_with class: "form space-y-4", url: queries_path, method: :post, local: true do |form| %>
      <%= form.hidden_field :project_id, value: @project.id %>
      
      <div>
        <%= form.label :query, "Query", class: "label" %>
        <%= form.text_area :query, required: true, class: "textarea textarea-bordered w-full", rows: 4, placeholder: "Enter your query..." %>
      </div>
      
      <div>
        <%= form.submit "Create Query", class: "btn btn-primary" %>
      </div>
    <% end %>
  <% else %>
    <div class="alert alert-warning">
      <p>This project must be published before you can create queries. Please edit the project and change its status to "Published".</p>
    </div>
  <% end %>
</div>

<% if @queries.any? %>
  <div class="mb-6">
    <h2 class="text-xl font-semibold mb-3">Query Responses</h2>
    <div class="space-y-4">
      <% @queries.each do |query| %>
        <div class="card bg-base-100 shadow-md">
          <div class="card-body">
            <h3 class="card-title text-lg">Query</h3>
            <p class="mb-3"><%= query.query %></p>

            <% if query.answer.present? %>
            <div class="mt-3">
              <h4 class="font-semibold mb-2">Answer:</h4>
              <div class="flex flex-wrap gap-2">
                <% query.answer.each do |term| %>
                  <span class="badge badge-soft"><%= term %></span>
                <% end %>
              </div>
            </div>
            <% end %>

            <% if query.response.present? %>
              <div class="mt-3">
                <details class="dropdown">
                <summary class="btn btn-sm btn-soft m-1">View Response</summary>
                  <div class="bg-base-200 p-4 rounded">
                    <% if query.response.is_a?(Hash) && query.response["content"] %>
                      <p><%= query.response["content"] %></p>
                    <% elsif query.response.is_a?(String) %>
                      <p><%= query.response %></p>
                    <% else %>
                      <pre><%= JSON.pretty_generate(query.response) %></pre>
                    <% end %>
                  </div>
                </details>
              </div>
            <% else %>
              <p class="text-gray-500 italic">Processing...</p>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  </div>
<% end %>

<%= link_to "Edit Project", edit_project_path(@project), class: "btn btn-soft" %>
<%= link_to "Back to Projects", projects_path, class: "btn btn-soft" %>
