<h1 class="text-2xl font-bold mb-4">Projects</h1>

<%= link_to "New project", new_project_path, class: "btn btn-soft" %>

<table class="table table-zebra table-pin-cols">
  <thead>
    <tr>
      <th>ID</th>
      <th>Name</th>
      <th>Slug</th>
      <th>Status</th>
      <th>Prompt Type</th>
      <th>Owner</th>
      <th>Actions</th>
    </tr>
  </thead>
  <tbody>
    <% if @projects.any? %>
      <% @projects.each do |project| %>
        <tr>
          <td><%= project.id %></td>
          <td><%= project.name %></td>
          <td><%= project.slug %></td>
          <td><%= project.status %></td>
          <td><%= project.prompt_type %></td>
          <td><%= project.owner&.email_address %></td>
          <td><%= link_to "Test", project_path(project), class: "btn btn-soft" %> <%= link_to "Edit", edit_project_path(project), class: "btn btn-soft" %></td>
        </tr>
      <% end %>
    <% else %>
      <tr>
        <td colspan="8">No projects found.</td>
      </tr>
    <% end %>
  </tbody>
</table>
