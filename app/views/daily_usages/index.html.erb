<h1 class="text-2xl font-bold mb-4">Daily Usage - <%= Date.current.strftime("%B %Y") %></h1>

<% 
  monthly_limit = ApplicationController::MAX_MONTHLY_TOKENS
  progress_percentage = [(@grand_total.to_f / monthly_limit * 100).round, 100].min
  progress_color = @grand_total >= monthly_limit ? "text-error" : (@grand_total >= monthly_limit * 0.8 ? "text-warning" : "text-success")
%>
<div class="mb-4">
  <div class="radial-progress bg-neutral border-4 border-neutral text-center <%= progress_color %>" style="--size:8rem; --value:<%= progress_percentage %>;" aria-valuenow="<%= progress_percentage %>" role="progressbar">
    <%= number_with_delimiter(@grand_total) %><br><small class="text-xs">/ <%= number_with_delimiter(monthly_limit) %></small>
  </div>
</div>

<% if @projects.any? %>
  <div class="overflow-x-auto">
    <table class="table table-pin-cols">
      <thead>
        <tr>
          <th class="sticky left-0 z-10 bg-base-200">Project</th>
          <% @days.each do |day| %>
            <th><%= day.strftime("%b %d") %></th>
          <% end %>
          <th class="font-bold">Total</th>
        </tr>
      </thead>
      <tbody>
        <% @projects.each do |project| %>
          <tr>
            <td class="sticky left-0 z-10 bg-base-200 font-medium">
              <%= project.name %>
            </td>
            <% @days.each do |day| %>
              <td class="text-right">
                <%= number_with_delimiter(@usage_map[[day, project.id]] || 0) %>
              </td>
            <% end %>
            <td class="sticky right-0 z-10 bg-base-200 text-right font-bold border-l">
              <%= number_with_delimiter(@project_totals[project.id]) %>
            </td>
          </tr>
        <% end %>
      </tbody>
      <tfoot>
        <tr class="font-bold">
          <td class="sticky left-0 z-10 bg-base-200">Total</td>
          <% @days.each do |day| %>
            <td class="text-right">
              <%= number_with_delimiter(@daily_totals[day]) %>
            </td>
          <% end %>
          <td class="sticky right-0 z-10 bg-base-200 text-right border-l">
            <%= number_with_delimiter(@grand_total) %>
          </td>
        </tr>
      </tfoot>
    </table>
  </div>
<% else %>
  <div class="alert alert-info">
    <span>No projects found. Create a project to start tracking usage.</span>
  </div>
<% end %>
